PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/finance-goals
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# JWT Secret - MUST be at least 32 characters in production
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32

# Email (required in production; falls back to console.log only in development)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Admin seed script — pass inline, do not store here:
# ADMIN_EMAIL=admin@example.com ADMIN_PASSWORD=<strong-password> yarn ts-node src/scripts/seed-admin.ts
