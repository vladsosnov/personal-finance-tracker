# Backend API URL (defaults to http://localhost:4000)
# NEXT_PUBLIC_API_URL=http://localhost:4000

# GraphQL endpoint override (defaults to NEXT_PUBLIC_API_URL/graphql)
# NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Base path for deployments behind a subpath (e.g. GitHub Pages)
# NEXT_PUBLIC_BASE_PATH=

# Public site URL used for metadata, sitemap, and robots.txt
# Example: NEXT_PUBLIC_SITE_URL=https://personal-finance-tracker-xyz.vercel.app
# NEXT_PUBLIC_SITE_URL=
